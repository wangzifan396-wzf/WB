har(ch){ return CHAR2RAD[ch]||null; }\r\nfunction allRadicals(){ return Object.keys(RAD); }\r\nvar EXPORTS={RAD:RAD,CHAR2RAD:CHAR2RAD,byRadical:byRadical,byChar:byChar,allRadicals:allRadicals};\r\n\r\nif (typeof module !== 'undefined' && module.exports) { module.exports = EXPORTS; }\r\nif (typeof window !== 'undefined') { window.RadicalForgePure = EXPORTS; }\r\n\r\n"
