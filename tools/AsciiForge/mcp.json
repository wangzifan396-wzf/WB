  "core": "\r\nvar FONT = {\r\n  'A':[14,17,17,31,17],'B':[30,17,30,17,30],'C':[15,16,16,16,15],'D':[30,17,17,17,30],\r\n  'E':[31,16,30,16,31],'F':[31,16,30,16,16],'G':[15,16,19,17,15],'H':[17,17,31,17,17],\r\n  'I':[31,4,4,4,31],'J':[7,2,2,18,14],'K':[17,18,20,18,17],'L':[16,16,16,16,31],\r\n  'M':[17,27,21,17,17],'N':[17,25,21,19,17],'O':[14,17,17,17,14],'P':[30,17,30,16,16],\r\n  'Q':[14,17,17,19,13],'R':[30,17,30,18,17],'S':[15,16,14,1,15],'T':[31,4,4,4,4],\r\n  'U':[17,17,17,17,14],'V':[17,17,17,10,4],'W':[17,17,21,27,17],'X':[17,10,4,10,17],\r\n  'Y':[17,10,4,4,4],'Z':[31,2,4,8,31],\r\n  '0':[14,19,21,25,14],'1':[4,12,4,4,14],'2':[14,17,12,8,31],'3':[30,1,14,1,30],\r\n  '4':[18,18,31,2,2],'5':[31,16,30,1,30],'6':[14,16,30,17,14],'7':[31,2,4,8,8],\r\n  '8':[14,17,14,17,14],'9':[14,17,15,1,14],' ':[0,0,0,0,0]\r\n};\r\nfunction glyphRows(ch){\r\n  var a=FONT[ch]; if(!a) a=FONT[' '];\r\n  return a.map(function(row){\r\n    var s=''; for(var b=4;b>=0;b--) s+=((row>>b)&1)?'#':'.'; return s;\r\n  });\r\n}\r\nfunction render(text){\r\n  text=String(text).toUpperCase();\r\n  var glyphs=[]; for(var i=0;i<text.length;i++) glyphs.push(glyphRows(text[i]));\r\n  var lines=[];\r\n  for(var r=0;r<5;r++){\r\n    var line='';\r\n    for(var g=0;g<glyphs.length;g++){ line+=glyphs[g][r]+(g<glyphs.length-1?' ':''); }\r\n    lines.push(line.replace(/\\s+$/,''));\r\n  }\r\n  return lines.join('\\n');\r\n}\r\nfunction repeat(ch,n){ var s=''; for(var i=0;i<n;i++) s+=ch; return s; }\r\nfunction box(text){\r\n  text=String(text); var w=text.length+2;\r\n  return ['┌'+repeat('─',w)+'┐','│ '+text+' │','└'+repeat('─',w)+'┘'].join('\\n');\r\n}\r\nvar LEET={'a':'4','e':'3','i':'1','o':'0','s':'5','t':'7','b':'8','g':'9','l':'1','z':'2'};\r\nfunction leet(text){\r\n  return String(text).replace(/[a-zA-Z]/g, function(m){ var low=m.toLowerCase(); return LEET[low]?LEET[low]:m; });\r\n}\r\nif (typeof module !== 'undefined' && module.exports) {\r\n  module.exports = { render:render, box:box, leet:leet, FONT:FONT };\r\n}\r\nif (typeof window !== 'undefined') {\r\n  window.AsciiForgePure = { render:render, box:box, leet:leet, FONT:FONT };\r\n}\r\n"
}