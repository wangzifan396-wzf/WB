{
  "name": "JsxForge - nano-tools",
  "short_name": "JsxForge",
  "description": "把 SVG 代码转成可直接使用的 React/JSX 组件：属性自动转驼峰、style 转对象、空元素自闭合，支持 TypeScript 签名与 props 透传，省去手工改写。 · 单文件 · 零依赖 · 本地优先",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0A0A0B",
  "theme_color": "#5E6AD2",
  "icons": [
    {
      "src": "og.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
