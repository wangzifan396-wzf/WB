  "core": "\r\nfunction hmgPoints(p){\r\n  var pts=[]; var N=p.N||2200; var dt=p.dt||0.03;\r\n  for(var i=0;i<N;i++){ var t=i*dt;\r\n    var x=p.A1*Math.sin(p.f1*t+p.p1)*Math.exp(-p.d1*t) + p.A2*Math.sin(p.f2*t+p.p2)*Math.exp(-p.d2*t);\r\n    var y=p.A3*Math.sin(p.f3*t+p.p3)*Math.exp(-p.d3*t) + p.A4*Math.sin(p.f4*t+p.p4)*Math.exp(-p.d4*t);\r\n    pts.push({x:x,y:y});\r\n  }\r\n  return pts;\r\n}\r\nif (typeof module !== 'undefined' && module.exports) {\r\n  module.exports = { hmgPoints:hmgPoints };\r\n}\r\nif (typeof window !== 'undefined') {\r\n  window.HarmonographForgePure = { hmgPoints:hmgPoints };\r\n}\r\n"
}