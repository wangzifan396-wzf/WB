  "core": "\r\nvar MASS={\"H\": 1.008, \"He\": 4.0026, \"Li\": 6.94, \"Be\": 9.0122, \"B\": 10.81, \"C\": 12.011, \"N\": 14.007, \"O\": 15.999, \"F\": 18.998, \"Ne\": 20.18, \"Na\": 22.99, \"Mg\": 24.305, \"Al\": 26.982, \"Si\": 28.085, \"P\": 30.974, \"S\": 32.06, \"Cl\": 35.45, \"Ar\": 39.948, \"K\": 39.098, \"Ca\": 40.078, \"Sc\": 44.956, \"Ti\": 47.867, \"V\": 50.942, \"Cr\": 51.996, \"Mn\": 54.938, \"Fe\": 55.845, \"Co\": 58.933, \"Ni\": 58.693, \"Cu\": 63.546, \"Zn\": 65.38, \"Ga\": 69.723, \"Ge\": 72.63, \"As\": 74.922, \"Se\": 78.971, \"Br\": 79.904, \"Kr\": 83.798, \"Rb\": 85.468, \"Sr\": 87.62, \"Y\": 88.906, \"Zr\": 91.224, \"Nb\": 92.906, \"Mo\": 95.95, \"Tc\": 98, \"Ru\": 101.07, \"Rh\": 102.91, \"Pd\": 106.42, \"Ag\": 107.87, \"Cd\": 112.41, \"In\": 114.82, \"Sn\": 118.71, \"Sb\": 121.76, \"Te\": 127.6, \"I\": 126.9, \"Xe\": 131.29, \"Cs\": 132.91, \"Ba\": 137.33, \"La\": 138.91, \"Ce\": 140.12, \"Pr\": 140.91, \"Nd\": 144.24, \"Pm\": 145, \"Sm\": 150.36, \"Eu\": 151.96, \"Gd\": 157.25, \"Tb\": 158.93, \"Dy\": 162.5, \"Ho\": 164.93, \"Er\": 167.26, \"Tm\": 168.93, \"Yb\": 173.05, \"Lu\": 174.97, \"Hf\": 178.49, \"Ta\": 180.95, \"W\": 183.84, \"Re\": 186.21, \"Os\": 190.23, \"Ir\": 192.22, \"Pt\": 195.08, \"Au\": 196.97, \"Hg\": 200.59, \"Tl\": 204.38, \"Pb\": 207.2, \"Bi\": 208.98, \"Po\": 209, \"At\": 210, \"Rn\": 222, \"Fr\": 223, \"Ra\": 226, \"Ac\": 227, \"Th\": 232.04, \"Pa\": 231.04, \"U\": 238.03, \"Np\": 237, \"Pu\": 244, \"Am\": 243, \"Cm\": 247, \"Bk\": 247, \"Cf\": 251, \"Es\": 252, \"Fm\": 257, \"Md\": 258, \"No\": 259, \"Lr\": 262, \"Rf\": 267, \"Db\": 268, \"Sg\": 269, \"Bh\": 270, \"Hs\": 269, \"Mt\": 278, \"Ds\": 281, \"Rg\": 282, \"Cn\": 285, \"Nh\": 286, \"Fl\": 289, \"Mc\": 290, \"Lv\": 293, \"Ts\": 294, \"Og\": 294};\r\nfunction molarity(mass_g, MW, vol_L){ if(vol_L===0) return null; return (mass_g/MW)/vol_L; }\r\nfunction massNeeded(C, MW, vol_L){ return C*MW*vol_L; }\r\nfunction dilution(C1,V1,C2){ if(C2===0) return null; return C1*V1/C2; } // 目标体积 V2\r\nfunction molality(mass_g, MW, mass_solvent_kg){ if(mass_solvent_kg===0) return null; return (mass_g/MW)/mass_solvent_kg; }\r\nvar EXPORTS={molarity:molarity, massNeeded:massNeeded, dilution:dilution, molality:molality};\r\n\r\nif (typeof module !== 'undefined' && module.exports) { module.exports = EXPORTS; }\r\nif (typeof window !== 'undefined') { window.MolarityForgePure = EXPORTS; }\r\n\r\n"
