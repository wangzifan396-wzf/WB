{
  "name": "OtpForge - nano-tools",
  "short_name": "OtpForge",
  "description": "一次性口令（OTP）生成器：粘贴 Base32 密钥或标准 otpauth:// URI，按 RFC 6238（TOTP）或 RFC 4226（HOTP）生成当前动态码，显示秒级倒计时与 ±1 周期时钟容错窗口，支持自定义位数与周期。可用于验证 Authenticator 配置、调试 2FA 集成，纯 JS 同步实现、零依赖、离线可用。 · 单文件 · 零依赖 · 本地优先",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "background_color": "#0A0A0B",
  "theme_color": "#5E6AD2",
  "icons": [
    {
      "src": "og.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    }
  ]
}
