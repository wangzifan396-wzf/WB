; }\r\nfunction bySym(s){ s=(s||'').trim(); for(var i=0;i<E.length;i++) if(E[i][1].toLowerCase()===s.toLowerCase()) return {num:E[i][0],sym:E[i][1],zh:E[i][2],mass:E[i][3],cat:categoryOf(E[i][1])}; return null; }\r\nfunction search(q){ q=(q||'').trim().toLowerCase(); var r=[]; for(var i=0;i<E.length;i++){ var e=E[i]; if(String(e[0])===q||e[1].toLowerCase()===q||e[2].indexOf(q)>=0) r.push({num:e[0],sym:e[1],zh:e[2],mass:e[3],cat:categoryOf(e[1])}); } return r; }\r\nvar EXPORTS={E:E,byNum:byNum,bySym:bySym,search:search,categoryOf:categoryOf};\r\n\r\n\r\nfunction rngFactory(seed){ var s=(seed>>>0)||1; return function(){ s=(s*1664525+1013904223)>>>0; return s/4294967296; }; }\r\n\r\nif (typeof module !== 'undefined' && module.exports) { module.exports = EXPORTS; }\r\nif (typeof window !== 'undefined') { window.PeriodicForgePure = EXPORTS; }\r\n\r\n"
